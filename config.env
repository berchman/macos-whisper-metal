# DropText / TAWK2TEXT config (single source of truth)

# Root project directory

PROJECT_ROOT="/Users/bertm/_00_GIT_MASTER/00_TAWK2TEXT"

# Folders

DROP_DIR="${PROJECT_ROOT}/_inbox"
FINAL_DIR="${PROJECT_ROOT}/_archive"         # where audio is moved
OUT_DIR="${PROJECT_ROOT}/_output"            # transcripts land here
LOG_DIR="${PROJECT_ROOT}/_logs"
MODEL_DIR="${PROJECT_ROOT}/_models"
TEMP_DIR="${PROJECT_ROOT}/_temp"

# Model
MODEL_FILE="${MODEL_DIR}/ggml-medium.bin"

# Output organization
JSON_DIR="${OUT_DIR}/json_files"             # rename from _sidecars

# Feature toggles (0/1)
ENABLE_JSON=1                 # needed for pause-based paragraphs + future timestamps/diarization
ENABLE_TIMESTAMPS=0           # timestamps in txt? (publisher should ignore if present)
ENABLE_WORDCOUNT=1
ENABLE_FOOTER=1               # footer block markers
DELETE_TEMP_WAV_ON_SUCCESS=1
DELETE_TEMP_WAV_ON_FAIL=0
