			"timestamps": {
				"from": "00:19:48,320",
				"to": "00:19:54,560"
			},
			"offsets": {
				"from": 1188320,
				"to": 1194560
			},
			"text": " It's about that time for me to get back on my feet, get a move in, get back."
		},
		{
			"timestamps": {
				"from": "00:19:54,560",
				"to": "00:20:03,560"
			},
			"offsets": {
				"from": 1194560,
				"to": 1203560
			},
			"text": " I got to get working on some art and I got to get an AI agent cleaning up my website"
