			"timestamps": {
				"from": "00:21:27,960",
				"to": "00:21:38,440"
			},
			"offsets": {
				"from": 1287960,
				"to": 1298440
			},
			"text": " It's at the point now where we're having a very good collaboration here and I'm enjoying"
