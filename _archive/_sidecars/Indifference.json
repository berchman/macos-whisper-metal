			"timestamps": {
				"from": "00:22:31,480",
				"to": "00:22:34,920"
			},
			"offsets": {
				"from": 1351480,
				"to": 1354920
			},
			"text": " and I'm just trying to get it out, get it out, get it out, get it out."
