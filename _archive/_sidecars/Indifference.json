		},
		{
			"timestamps": {
				"from": "00:22:16,320",
				"to": "00:22:25,920"
			},
			"offsets": {
				"from": 1336320,
				"to": 1345920
			},
			"text": " downloads, I don't know, I'm just why I'm asking you if you have any ideas."
		},
		{
			"timestamps": {
				"from": "00:22:25,920",
				"to": "00:22:31,480"
			},
			"offsets": {
				"from": 1345920,
				"to": 1351480
			},
			"text": " My head's so wrapped up and dumping out this material, it's fucking backlogged in my head"
		},
