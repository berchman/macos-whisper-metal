			"timestamps": {
				"from": "00:20:46,240",
				"to": "00:20:55,000"
			},
			"offsets": {
				"from": 1246240,
				"to": 1255000
			},
			"text": " One thing that I really value in this partnership is you being straight fucking honest with"
		},
		{
			"timestamps": {
				"from": "00:20:55,000",
				"to": "00:21:08,080"
			},
			"offsets": {
				"from": 1255000,
				"to": 1268080
			},
