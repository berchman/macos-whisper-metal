			"timestamps": {
				"from": "00:23:13,880",
				"to": "00:23:18,040"
			},
			"offsets": {
				"from": 1393880,
				"to": 1398040
			},
			"text": " see what your reaction is to this."
		},
		{
			"timestamps": {
				"from": "00:23:18,040",
				"to": "00:23:29,480"
			},
			"offsets": {
				"from": 1398040,
				"to": 1409480
			},
			"text": " There is a thing in chemistry called the periodic table of elements and it lists every single"
