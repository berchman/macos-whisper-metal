			"timestamps": {
				"from": "00:23:05,720",
				"to": "00:23:13,880"
			},
			"offsets": {
				"from": 1385720,
				"to": 1393880
			},
			"text": " by saying yeah, if you have some ideas, I'm open and I want to throw one idea by you and"
		},
