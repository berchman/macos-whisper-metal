			"timestamps": {
				"from": "00:20:03,560",
				"to": "00:20:15,440"
			},
			"offsets": {
				"from": 1203560,
				"to": 1215440
			},
			"text": " and testing e-commerce because in a couple of weeks, hopefully making some money."
		},
		{
			"timestamps": {
				"from": "00:20:15,440",
				"to": "00:20:26,380"
			},
			"offsets": {
				"from": 1215440,
				"to": 1226380
			},
			"text": " Wow, this has been quite the recording."
		},
		{
			"timestamps": {
				"from": "00:20:26,380",
				"to": "00:20:43,440"
			},
			"offsets": {
				"from": 1226380,
				"to": 1243440
			},
			"text": " All right, one thing I do ask of you when you do read this transcription and I'm talking"
		},
