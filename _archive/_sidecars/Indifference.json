			"timestamps": {
				"from": "00:22:45,460",
				"to": "00:23:05,720"
			},
			"offsets": {
				"from": 1365460,
				"to": 1385720
			},
			"text": " So I'm wondering about another idea I have and so yes, let me wrap up that thought just"
		},
