			"timestamps": {
				"from": "00:21:38,440",
				"to": "00:21:45,520"
			},
			"offsets": {
				"from": 1298440,
				"to": 1305520
			},
			"text": " it a whole lot."
		},
		{
			"timestamps": {
				"from": "00:21:45,520",
				"to": "00:22:04,080"
			},
			"offsets": {
				"from": 1305520,
				"to": 1324080
			},
			"text": " And I'm wondering if I could ask a small favor of you and that is to noodle on perhaps some"
		},
