			"timestamps": {
				"from": "00:23:39,800",
				"to": "00:23:49,880"
			},
			"offsets": {
				"from": 1419800,
				"to": 1429880
			},
			"text": " And when I was in the deep parts of my hall of mirrors, floors and ceilings inside my"
		},
